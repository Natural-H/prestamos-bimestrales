# Copia este archivo a .env y ajusta los valores. El .env real NO se versiona.

# --- API ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL 18 (docker-compose) ---
DB_HOST=localhost
# 5433 y no 5432: es habitual tener ya un PostgreSQL local en el puerto
# estandar. Esta variable fija a la vez el puerto publicado por el
# contenedor y el que usa la API, asi que basta cambiarla aqui.
DB_PORT=5433
DB_USER=prestamos
DB_PASSWORD=prestamos
DB_NAME=prestamos_bimestrales

# --- Autenticacion (RN-17) ---
# En produccion debe ser un secreto largo y aleatorio, nunca este valor.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=3600
