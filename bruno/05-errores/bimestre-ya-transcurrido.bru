meta {
  name: Bimestre ya transcurrido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/solicitudes/bimestres
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenTrabajador}}
}

body:json {
  {
    "bimestres": [
      { "mesReferencia": 2 }
    ]
  }
}

assert {
  res.status: eq 409
  res.body.codigo: eq BIMESTRE_BLOQUEADO
}

docs {
  EC-01. El bloqueo es una regla de negocio, no un filtro visual: la API
  rechaza de verdad (RN-04). Ejecutalo despues del 1 de marzo del ano en
  curso; antes de esa fecha febrero sigue disponible y responde 200.
}
